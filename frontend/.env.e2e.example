# Copy to frontend/.env.e2e and fill in the two Alpha test accounts.
# .env.e2e is git-ignored; never commit real passwords.

E2E_BASE_URL=http://127.0.0.1:5173
E2E_API_URL=http://localhost:8080/api/v1

# Account A (trip owner)
E2E_OWNER_EMAIL=owner@example.com
E2E_OWNER_PASSWORD=change-me

# Account B (invited member) — username is what the invite search matches.
E2E_MEMBER_EMAIL=member@example.com
E2E_MEMBER_PASSWORD=change-me
E2E_MEMBER_USERNAME=member

# Sample trip data (defaults match the Alpha plan: Fuzhou weekend)
E2E_TRIP_PREFIX=Alpha E2E
E2E_TRIP_DESTINATION=Fuzhou
E2E_TRIP_START=2026-11-28
E2E_TRIP_END=2026-11-29
